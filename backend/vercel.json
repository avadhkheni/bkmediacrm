{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["prisma/schema.prisma"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/pdf/requirements/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/api/v1/pdf/dispatch/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/api/v1/pdf/expense-report/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/api/v1/pdf/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
